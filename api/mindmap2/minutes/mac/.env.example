# ~/.minutes2/.env に置く（chmod 600）。値はどれもこの Mac の外に出さない

# データ用の private リポジトリ
GH_OWNER=ymatsuda-cmyk
GH_REPO=minutes-data
GH_BRANCH=main
# 書き込み用（fine-grained / minutes-data だけ / Contents: Read and write）。Mac と GAS が使う
GH_TOKEN=github_pat_xxxxxxxx
# 読み取り用（fine-grained / minutes-data だけ / Contents: Read-only）。鍵束に入れて各端末に配る
GH_READ_TOKEN=github_pat_yyyyyyyy

# jsonbin（鍵束の置き場）
JSONBIN_KEY=$2a$10$xxxxxxxx
# setup_keys.py init で作られる。作られたら書き足しておく
JSONBIN_BIN_ID=

# 音声の受付フォルダ（Google ドライブ for desktop で同期した場所）
DRIVE_DIR=~/Library/CloudStorage/GoogleDrive-あなたのアドレス/マイドライブ/minutes2-inbox

# 文字起こしのモデル
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Claude.ai との受け渡し（使わないなら空のまま）
NOTION_TOKEN=
NOTION_DB_ID=
